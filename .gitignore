# Local configuration and credentials (Firebase client settings live in .env)
.env
.env.*
!.env.example
*service-account*.json
*.pem
*.p12
*.key
*.crt

# Editors and operating systems
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# Local editable Revit model and automatic backup; IFC is the versioned test input.
/Precast_Module_Test.rvt
/Precast_Module_Test.0001.rvt
/samples/test-module/*.rvt

# Repository policy: keep GitHub focused on source code and system structure.
# Heavy drawings, engineering outputs and reference media stay local.
/output/
/deliverables/
/references/
/Australia Spec/
/Picture Stock/
/apps/web/public/
/samples/

# Locally vendored runtimes/tool binaries
/tools/**/python-packages/
/tools/**/video-python/
/tools/**/video-vendor/

# TypeScript build products emitted beside source files
/apps/**/*.js
/apps/**/*.js.map
/packages/**/*.js
/packages/**/*.js.map
/firebase/**/*.js
/firebase/**/*.js.map
*.d.ts

