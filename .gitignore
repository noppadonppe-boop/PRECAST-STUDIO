# Dependencies and generated output
node_modules/
node_modules.interrupted-*/
.pnpm-store/
.local-engineering-runtime/
__pycache__/
dist/
dist-catalogue/
coverage/
.vite/
*.tsbuildinfo

# Local tooling and emulators
.firebase/
.firebase-config/
.firebase-cache/
firebase-debug.log
firestore-debug.log
ui-debug.log
tmp/
playwright-report/
