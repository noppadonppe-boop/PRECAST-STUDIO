# Copy to repository-root .env.local. Default is local fixture.
# Staging requires the operator-reviewed firebase/staging-target.json projectId.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-precast-m1
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_APPCHECK_SITE_KEY=
VITE_DATA_MODE=fixture
VITE_DEFAULT_ORG_ID=org-siam
VITE_EMULATOR_USER_EMAIL=checker@precast.local
VITE_EMULATOR_USER_PASSWORD=local-emulator-only
# No service-account keys, passwords for staging users, or debug tokens here.
