rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasActiveProjectMembership(orgId, projectId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active'
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid)).data.effectiveFrom <= request.time
        && (!('expiresAt' in firestore.get(/databases/(default)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid)).data)
          || firestore.get(/databases/(default)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid)).data.expiresAt > request.time);
    }

    function hasProjectRole(orgId, projectId, role) {
      return hasActiveProjectMembership(orgId, projectId)
        && role in firestore.get(/databases/(default)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid)).data.roles;
    }

    match /organizations/{orgId}/projects/{projectId}/source-staging/{uid}/{uploadId}/{fileName} {
      allow read: if hasActiveProjectMembership(orgId, projectId)
        && resource.metadata.scanState == 'clean';
      allow create: if hasProjectRole(orgId, projectId, 'bimCoordinator')
        && uid == request.auth.uid
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && ((fileName.matches('.*\\.[pP][dD][fF]') && request.resource.contentType == 'application/pdf')
          || (fileName.matches('.*\\.[iI][fF][cC]')
            && request.resource.contentType in ['application/x-step', 'application/ifc', 'text/plain']))
        && request.resource.metadata.scanState == 'quarantined'
        && request.resource.metadata.uploadedBy == request.auth.uid
        && request.resource.metadata.orgId == orgId
        && request.resource.metadata.projectId == projectId;
      allow update, delete: if false;
    }

    match /organizations/{orgId}/projects/{projectId}/deliverables/{path=**} {
      allow read: if hasActiveProjectMembership(orgId, projectId);
      allow write: if false;
    }

    // Shared PRECAST MODULE files are organized by menu/document, never by user.
    match /{workspaceRoot}/{category}/{documentId}/{fileId}/{fileName} {
      allow read: if request.auth != null && workspaceRoot == 'PRECAST MODULE'
        && category in ['projects', 'intake', 'criteria', 'panel', 'loads', 'analysis', 'design', 'cost', 'report', 'shop', 'release', 'review', 'team', 'libraries', 'settings'];
      allow create: if resource == null && request.auth != null && workspaceRoot == 'PRECAST MODULE'
        && category in ['projects', 'intake', 'criteria', 'panel', 'loads', 'analysis', 'design', 'cost', 'report', 'shop', 'release', 'review', 'team', 'libraries', 'settings']
        && request.resource.size > 0 && request.resource.size <= 100 * 1024 * 1024
        && request.resource.metadata.uploadedBy == request.auth.uid
        && request.resource.contentType != null;
      allow update, delete: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
