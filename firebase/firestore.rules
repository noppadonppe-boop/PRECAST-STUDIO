rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasActiveOrgMembership(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function hasActiveProjectMembership(orgId, projectId) {
      return hasActiveOrgMembership(orgId)
        && exists(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid)).data.effectiveFrom <= request.time
        && (!('expiresAt' in get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid)).data.expiresAt > request.time);
    }

    function hasProjectRole(orgId, projectId, role) {
      return hasActiveProjectMembership(orgId, projectId)
        && role in get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)/members/$(request.auth.uid)).data.roles;
    }

    function isExternalReviewer(orgId, projectId) {
      return hasProjectRole(orgId, projectId, 'externalReviewer');
    }

    function isInternalProjectMember(orgId, projectId) {
      return hasActiveProjectMembership(orgId, projectId)
        && !isExternalReviewer(orgId, projectId);
    }

    function isSharedIssuedContent(orgId, projectId) {
      return isExternalReviewer(orgId, projectId)
        && resource.data.status in ['approved', 'issued']
        && request.auth.uid in resource.data.sharedWithUids;
    }

    match /organizations/{orgId} {
      allow read: if hasActiveOrgMembership(orgId);
      allow write: if false;

      match /members/{memberId} {
        allow read: if hasActiveOrgMembership(orgId) && (memberId == request.auth.uid || 'orgAdmin' in get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.orgRoles);
        allow write: if false;
      }

      match /priceBooks/{priceBookId} {
        allow read: if hasActiveOrgMembership(orgId);
        // Price Book revisions are managed only by authoritative commercial administration.
        allow write: if false;
      }

      match /projects/{projectId} {
        allow read: if isInternalProjectMember(orgId, projectId);
        allow write: if false;

        match /members/{memberId} {
          allow read: if isInternalProjectMember(orgId, projectId);
          allow write: if false;
        }

        match /designBasisVersions/{artifactId} {
          allow read: if isInternalProjectMember(orgId, projectId);
          // Creation/superseding is authoritative so project current-revision state changes atomically.
          allow create: if false;
          allow update: if hasProjectRole(orgId, projectId, 'structuralEngineer')
            && resource.data.status == 'draft'
            && request.resource.data.status == resource.data.status
            && resource.data.locked == false
            && request.resource.data.locked == false
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revision == resource.data.revision
            && request.resource.data.upstreamRefs == resource.data.upstreamRefs
            && request.resource.data.isCurrentRevision == resource.data.isCurrentRevision
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'draftHash', 'updatedAt', 'updatedBy']);
          allow delete: if false;
        }

        match /sourceRevisions/{artifactId} {
          allow read: if isInternalProjectMember(orgId, projectId);
          allow create: if hasProjectRole(orgId, projectId, 'bimCoordinator')
            && request.resource.data.status == 'draft'
            && request.resource.data.scanState == 'quarantined'
            && request.resource.data.locked == false
            && request.resource.data.createdBy == request.auth.uid;
          allow update: if hasProjectRole(orgId, projectId, 'bimCoordinator')
            && resource.data.status == 'draft'
            && resource.data.scanState == 'quarantined'
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.status == resource.data.status
            && request.resource.data.scanState == resource.data.scanState
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.storagePath == resource.data.storagePath
            && request.resource.data.revision == resource.data.revision
            && request.resource.data.isCurrentRevision == resource.data.isCurrentRevision;
          allow delete: if false;
        }

        match /productModelVersions/{artifactId} {
          allow read: if isInternalProjectMember(orgId, projectId);
          // Creation and superseding update the project pointer through one authoritative transaction.
          allow create: if false;
          allow update: if hasProjectRole(orgId, projectId, 'structuralEngineer')
            && resource.data.status == 'draft'
            && request.resource.data.status == resource.data.status
            && resource.data.locked == false
            && request.resource.data.locked == false
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revision == resource.data.revision
            && request.resource.data.upstreamRefs == resource.data.upstreamRefs
            && request.resource.data.isCurrentRevision == resource.data.isCurrentRevision
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'draftHash', 'updatedAt', 'updatedBy']);
          allow delete: if false;
        }

        match /loadModelVersions/{artifactId} {
          allow read: if isInternalProjectMember(orgId, projectId);
          // Creation and freezing are authoritative; the author can edit only the current unlocked draft.
          allow create: if false;
          allow update: if hasProjectRole(orgId, projectId, 'structuralEngineer')
            && resource.data.status == 'draft'
            && request.resource.data.status == resource.data.status
            && resource.data.locked == false
            && request.resource.data.locked == false
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revision == resource.data.revision
            && request.resource.data.upstreamRefs == resource.data.upstreamRefs
            && request.resource.data.isCurrentRevision == resource.data.isCurrentRevision
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'draftHash', 'updatedAt', 'updatedBy']);
          allow delete: if false;
        }

        match /analysisRuns/{runId} {
          allow read: if isInternalProjectMember(orgId, projectId);
          // Lifecycle, manifest, hashes and normalized results are server-authoritative.
          allow write: if false;
        }

        match /calculationReports/{calculationId} {
          allow read: if isInternalProjectMember(orgId, projectId);
          // Design-check generation, review snapshots and approval remain server-authoritative.
          allow write: if false;
        }

        match /estimateVersions/{estimateId} {
          allow read: if isInternalProjectMember(orgId, projectId);
          // QTO, price resolution, totals and lifecycle are server-authoritative.
          allow write: if false;
        }

        match /issues/{issueId} {
          allow read: if isInternalProjectMember(orgId, projectId);
          allow create: if isInternalProjectMember(orgId, projectId)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == 'open';
          allow update: if isInternalProjectMember(orgId, projectId)
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.artifactType == resource.data.artifactType
            && request.resource.data.artifactId == resource.data.artifactId
            && request.resource.data.artifactRevision == resource.data.artifactRevision
            && (request.resource.data.status != 'acceptedException'
              || (hasProjectRole(orgId, projectId, 'projectManager')
                && request.resource.data.dispositionReason.size() >= 3
                && request.resource.data.responsibleUid.size() >= 1));
          allow delete: if false;
        }

        match /approvalRequests/{requestId} {
          allow read: if isInternalProjectMember(orgId, projectId);
          // Requests and decisions are authoritative server commands only.
          allow write: if false;
        }

        match /auditEvents/{eventId} {
          allow read: if isInternalProjectMember(orgId, projectId);
          // Admin SDK command handlers append these after authorization.
          allow write: if false;
        }

        match /calculationReports/{reportId} {
          allow read: if isInternalProjectMember(orgId, projectId) || isSharedIssuedContent(orgId, projectId);
          allow write: if false;
        }

        match /drawingSets/{drawingSetId} {
          allow read: if isInternalProjectMember(orgId, projectId) || isSharedIssuedContent(orgId, projectId);
          allow write: if false;
        }

        match /{document=**} {
          allow read: if isInternalProjectMember(orgId, projectId);
          allow write: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
